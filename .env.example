# RobinHood AI — backend environment configuration
# Copy to `.env` (gitignored) and fill in real values.
# Generate crypto + admin secrets with:  python robinhood_cli.py admin init-keys

FLASK_ENV=production

# --- Supabase (backend uses the SERVICE ROLE key only; never ship it to the frontend) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Local pepper used only for PAN blind-index hashing (HMAC key), independent of the Fernet master key
PAN_BLIND_INDEX_PEPPER=change-me-random-32-bytes

# --- Field-level encryption master key (Fernet) ---
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRYPTO_KEY=

# --- Flask session / admin auth ---
SESSION_SECRET=
ADMIN_EMAIL=admin@robinhood.gov.in
# Generate:  python robinhood_cli.py admin login-hash --password 'YourStrongPass'
ADMIN_PASSWORD_HASH=

# Allowed frontend origin for CORS (no trailing slash)
CORS_ORIGIN=http://localhost:8080
